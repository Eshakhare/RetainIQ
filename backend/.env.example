# Optional: enables the LLM-written briefings (Gemini on Vertex AI).
# Without these the agent uses template text.
LLM_PROVIDER=vertex
LLM_MODEL=gemini-2.5-flash-lite
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Path to the service-account key JSON (needs role: Vertex AI User, roles/aiplatform.user)
GOOGLE_APPLICATION_CREDENTIALS=\path\to\service-account.json
